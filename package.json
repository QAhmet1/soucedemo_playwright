{
  "scripts": {
    "pretest": "rimraf allure-results allure-report playwright-report",
    "test:all": "ENV=prod npx playwright test",
    "test:headed": "npm run pretest && ENV=prod npx playwright test --headed && npm run report",
    "test:ui": "ENV=prod npx playwright test tests/ui",
    "test:api": "ENV=prod npx playwright test tests/api",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "allure-commandline": "^2.36.0",
    "allure-playwright": "^3.4.3",
    "rimraf": "^6.1.2"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
